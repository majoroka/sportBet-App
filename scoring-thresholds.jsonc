                { "at": 40, "points": 5, "status": "good" },
                { "at": 80, "points": 3, "status": "warn" },
                { "at": 120, "points": 1, "status": "warn" },
                { "at": 9999, "points": 0, "status": "bad" }
              ]
            }
          ]
        }
