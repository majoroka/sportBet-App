          "maxPoints": 10,
          "condition": "probBtts < 46"
        },
        {
          "key": "team_pct_scored_low",
          "label": "% marcar < 65% (qualquer equipa)",
          "points": -6,
          "maxPoints": 6,
          "condition": "homePctScored < 65 OR awayPctScored < 65"
        },
        {
          "key": "clean_sheet_high",
          "label": "Clean sheets > 45% (qualquer equipa)",
          "points": -6,
          "maxPoints": 6,
          "condition": "homeCleanSheetPct > 45 OR awayCleanSheetPct > 45"
        },
        {
          "key": "prob_over25_low",
          "label": "Prob. Over2.5 < 40%",
          "points": -5,
          "maxPoints": 5,
          "condition": "probOver25 < 40"
        },
        {
          "key": "low_gf_and_sot",
          "label": "GF/jogo < 1.0 e SOT/jogo < 2.8",
          "points": -5,
          "maxPoints": 5,
          "condition": "(homeGF < 1.0 AND homeSOT < 2.8) OR (awayGF < 1.0 AND awaySOT < 2.8)"
        }
      ]
    },

    "over_2_5_match": {
      "label": "Over 2.5 (Jogo)",
      "mode": "match",
      "source": "src/scoring/models/over25Match.config.ts",
      "interpretation": {
        "ranges": [
          { "min": 75, "label": "excelente" },
          { "min": 65, "max": 74, "label": "bom" },
          { "min": 55, "max": 64, "label": "borderline" },
          { "max": 54, "label": "evitar" }
        ]
      },
      "penaltyCap": 20,
      "groups": [
        {
          "key": "A",
          "label": "A. Núcleo",
          "items": [
            {
              "key": "prob_over25",
              "label": "Prob. Over 2.5",
              "maxPoints": 30,
              "thresholds": [
                { "at": 58, "points": 30, "status": "good" },
                { "at": 54, "points": 26, "status": "good" },
                { "at": 50, "points": 22, "status": "good" },
                { "at": 46, "points": 18, "status": "warn" },
                { "at": 42, "points": 12, "status": "warn" },
                { "at": 38, "points": 6, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            }
          ]
        },
        {
          "key": "B",
          "label": "B. Perfil de golos",
          "items": [
            {
              "key": "game_goals_profile",
              "label": "Perfil de golos do jogo",
              "maxPoints": 15,
              "notes": "gameGoalsProfile = ((homeGF+homeGA)+(awayGF+awayGA))/2",
              "thresholds": [
                { "at": 3.2, "points": 15, "status": "good" },
                { "at": 3.0, "points": 12, "status": "good" },
                { "at": 2.8, "points": 9, "status": "warn" },
                { "at": 2.6, "points": 6, "status": "warn" },
                { "at": 2.4, "points": 3, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            },
            {
              "key": "ga_vulnerability",
              "label": "Vulnerabilidade defensiva (GA/jogo)",
              "maxPoints": 10,
              "notes": "Custom logic in computeOver25MatchScore",
              "logic": [
                { "when": "homeGA >= 1.2 AND awayGA >= 1.2", "points": 10, "status": "good" },
                { "when": "homeGA >= 1.0 AND awayGA >= 1.0", "points": 7, "status": "good" },
                { "when": "homeGA >= 1.2 OR awayGA >= 1.2", "points": 5, "status": "warn" },
                { "when": "homeGA >= 1.0 OR awayGA >= 1.0", "points": 3, "status": "warn" },
                { "when": "else", "points": 0, "status": "bad" }
              ]
            }
          ]
        },
        {
          "key": "C",
          "label": "C. Consistência a marcar",
          "items": [
            {
              "key": "avg_pct_scored",
              "label": "% médio de jogos a marcar",
              "maxPoints": 9,
              "notes": "avgPctScored = (homePctScored + awayPctScored)/2",
              "thresholds": [
                { "at": 85, "points": 9, "status": "good" },
                { "at": 78, "points": 7, "status": "good" },
                { "at": 70, "points": 5, "status": "warn" },
                { "at": 62, "points": 3, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            },
            {
              "key": "max_pct_team15",
              "label": "Máx. % equipa 2+ golos",
              "maxPoints": 6,
              "notes": "maxPctTeam15 = max(homePct15Scored, awayPct15Scored)",
              "thresholds": [
                { "at": 55, "points": 6, "status": "good" },
                { "at": 45, "points": 4, "status": "warn" },
                { "at": 35, "points": 2, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            }
          ]
        },
        {
          "key": "D",
          "label": "D. Remates / SOT",
          "items": [
            {
              "key": "avg_sot_for",
              "label": "SOT médio a favor",
              "maxPoints": 10,
              "notes": "avgSOTFor = (homeSOT + awaySOT)/2",
              "thresholds": [
                { "at": 5.0, "points": 10, "status": "good" },
                { "at": 4.4, "points": 8, "status": "good" },
                { "at": 3.8, "points": 6, "status": "warn" },
                { "at": 3.2, "points": 3, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            },
            {
              "key": "avg_sot_against",
              "label": "SOT médio sofrido",
              "maxPoints": 10,
              "notes": "avgSOTAgainst = (homeSOTAgainst + awaySOTAgainst)/2",
              "thresholds": [
                { "at": 4.8, "points": 10, "status": "good" },
                { "at": 4.2, "points": 8, "status": "good" },
                { "at": 3.6, "points": 6, "status": "warn" },
                { "at": 3.0, "points": 3, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            }
          ]
        },
        {
          "key": "E",
          "label": "E. Ritmo / 1ª parte",
          "items": [
            {
              "key": "avg_first_half_goal_pct",
              "label": "% médio golo 1ª parte",
              "maxPoints": 6,
              "notes": "avgFirstHalfGoalPct = (homeFHG + awayFHG)/2",
              "thresholds": [
                { "at": 65, "points": 6, "status": "good" },
                { "at": 58, "points": 4, "status": "warn" },
                { "at": 50, "points": 2, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            },
            {
              "key": "ht_profile",
              "label": "Perfil HT (GF+GA 1ª parte)",
              "maxPoints": 4,
              "notes": "htProfile = ((homeHTGF+homeHTGA)+(awayHTGF+awayHTGA))/2",
              "thresholds": [
                { "at": 1.35, "points": 4, "status": "good" },
                { "at": 1.1, "points": 3, "status": "good" },
                { "at": 0.9, "points": 2, "status": "warn" },
                { "at": 0, "points": 0, "status": "bad" }
              ]
            }
          ]
        }
      ],
      "penalties": [
        {
          "key": "prob_over25_low",
          "label": "Prob. Over 2.5 < 46%",
          "points": -10,
          "maxPoints": 10,
          "condition": "probOver25 < 46"
        },
        {
          "key": "game_goals_profile_low",
          "label": "Perfil de golos do jogo < 2.4",
          "points": -6,
          "maxPoints": 6,
          "condition": "gameGoalsProfile < 2.4"
        },
        {
          "key": "both_ga_low",
          "label": "Ambos GA/jogo < 1.0",
          "points": -6,
          "maxPoints": 6,
          "condition": "homeGA < 1.0 AND awayGA < 1.0"
        },
        {
          "key": "avg_sot_for_low",
          "label": "SOT médio a favor < 3.2",
          "points": -5,
          "maxPoints": 5,
          "condition": "avgSOTFor < 3.2"
        },
        {
          "key": "low_ou_line",
          "label": "Linha O/U <= 2.0",
          "points": -4,
          "maxPoints": 4,
          "condition": "ouLine <= 2.0"
        }
      ]
    },

