          { "min": 60, "max": 69, "label": "ok" },
          { "max": 59, "label": "evitar" }
        ]
      },
      "penaltyCap": 20,
      "groups": [
        {
          "key": "A",
          "label": "A. Núcleo",
          "items": [
            {
              "key": "prob_over05_ht",
              "label": "Prob. Over 0.5 HT",
